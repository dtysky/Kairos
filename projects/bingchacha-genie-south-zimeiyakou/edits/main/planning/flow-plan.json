  "summary": "codex-agent-v1 旅行纪录片剪辑流：由 Codex Agent 直接维护，先生成 edit-framework handoff，再按 framework/spans/assets 做素材召回，随后同步 Resolve Media Pool、生成粗剪时间线、人工锁定粗剪，最后生成源语音字幕与无语音段落旁白草稿。",
  "assumptions": [
    "当前 travel-documentary 规则没有明确要求独立事件表、行程表、素材档案或素材库文档，因此不生成 trip.event_table 或 material.archive。",
    "“LLM生成文本稿件”在初版剪辑框架阶段解释为 edit.framework 的可审查 handoff，而不是额外 script.generate step。",
    "edit.framework 可以读取 confirmed chronology 作为上游事实理解输入，但输出不能写 chronology/event/route/gap/span/asset id，也不能另写 beat 边界索引。",
    "material.recall 固定只消费 edit-framework.md、store/spans.json、store/assets.json；span 的真实时间由 corrected asset.capturedAt 与 source range 计算，不消费 chronology 或 asset reports。",
    "resolve.media_sync 和 timeline.generate 仍可读取 media/chronology.json，但只用于 Resolve Media Pool bin、路径和上下文映射，不能改变 material-slots 的选择或顺序。",
    "所选风格档案只授权给 postlock.subtitle_narration 的文学层；粗剪结构、素材召回、静音和加速规则只来自剪辑规则与 reviewed planning artifacts。"
  ],
  "styleUsage": {
    "styleCategory": "china-drive-travel-documentary-main",
    "styleProfileHash": "2a170c1a65f4d3ae9b64d4d99e76a02f3498170e31c798b7ed668592dc4b52ad",
    "styleProfileVersion": "layered-v1",
    "layers": {
      "literary": {
        "mode": "hard",
        "appliesTo": [
          "postlock.subtitle_narration"
        ],
        "rationale": "剪辑规则收尾阶段要求无语音段落旁白稿参考指定风格分析结果；仅文学层进入旁白/字幕写作。"
      },
      "artistic": {
        "mode": "off",
        "appliesTo": [],
        "rationale": "当前规则未要求将风格档案的艺术层作为粗剪结构、画面选择或调色依据。"
      },
      "editingTechnical": {
        "mode": "off",
        "appliesTo": [],
        "rationale": "当前粗剪节奏、素材排序、静音和加速规则已由 travel-documentary 剪辑规则显式定义。"
      }
    },
    "rationale": "风格档案是 Edit Unit 绑定的后期文本风格输入，不替代剪辑规则。"
  },
  "steps": [
    {
      "id": "edit-framework-handoff-codex-v1",
      "capabilityId": "edit.framework",
      "title": "生成剪辑框架 handoff",
      "inputRefs": [
        "config/edit-rules/travel-documentary.md",
        "media/chronology.json",
        "store/spans.json",
        "store/assets.json"
      ],
      "outputRefs": [
        "edits/<editId>/planning/edit-framework.md"
      ],
      "outputTypes": {
        "edits/<editId>/planning/edit-framework.md": "planning-markdown"
      },
      "runner": "agent",
      "execution": {
        "mode": "sharded-agent",
        "shardBy": "day",
        "shardPacking": {
          "base": "day",
          "metric": "chronologyEventCount",
          "maxPerShard": 80,
          "preserveOrder": true
        },
        "codexSubagentProfile": {
          "reasoningEffort": "high",
          "forkContext": false,
          "speed": "standard"
        },
        "reason": "规则明确要求使用 SubAgent，按天但约 80 个事件阈值连续打包，生成全片章节与唯一分段操作稿。"
      },
      "gate": "human",
      "notes": [
        "必须原样遵守剪辑规则附录中的 edit-framework 模板结构。",
        "分段操作稿是 material.recall 的唯一 beat handoff；不得另写 beat 边界索引。",
        "spans 列必须写类型数量和视频语音拆分，例如“共28段：行车13（有语音5/无语音8）、航拍7、普通视频4（有语音2/无语音2）、照片4”。",
        "主表不得写 event/route/gap/span/asset id 或具体素材主键；叙事列只写客观画面/声音总结，不写剪辑指导。"
      ]
    },
    {
      "id": "material-recall-codex-v1",
      "capabilityId": "material.recall",
      "title": "按剪辑框架召回素材槽位",
      "inputRefs": [
        "edits/<editId>/planning/edit-framework.md",
        "store/spans.json",
        "store/assets.json"
      ],
      "outputRefs": [
        "edits/<editId>/script/material-slots.json"
      ],
      "outputTypes": {
        "edits/<editId>/script/material-slots.json": "material-slots-json"
      },
      "runner": "agent",
      "execution": {
        "mode": "sharded-agent",
        "shardBy": "day",
        "shardPacking": {
          "base": "day",
          "metric": "materialRefCount",
          "maxPerShard": 2000,
          "preserveOrder": true
        },
        "codexSubagentProfile": {
          "reasoningEffort": "high",
          "forkContext": false,
          "speed": "standard"
        },
        "reason": "规则明确要求素材召回使用 SubAgent，按天但约 2000 个 span 阈值连续打包。"
      },
      "gate": "human",
      "notes": [
        "只能按 edit-framework.md 的分段操作稿 FW beat 顺序召回，不读取 chronology 作为语义接口。",
        "口播与纯视觉窗口重叠时优先选择口播窗口。",
        "同一原始素材的无口播行车 span 先按画面语义去重，最多保留三段。",
        "无口播行车 span 直接静音；超过 5 秒的静音行车片段通过加速压到 5 秒内。",
        "material-slots.json 必须保留 chosenSpanIds/treatments 中的人类可读素材主键以供审查溯源。"
      ]
    },
    {
      "id": "resolve-media-sync-codex-v1",
      "capabilityId": "resolve.media_sync",
      "title": "同步 Resolve Media Pool 工程归档",
      "inputRefs": [
        "store/spans.json",
        "store/assets.json",
        "media/chronology.json",
        "config/project-brief.json"
      ],
      "outputRefs": [
        "DaVinci Resolve Media Pool"
      ],
      "outputTypes": {
        "DaVinci Resolve Media Pool": "resolve-state"
      },
      "runner": "deterministic",
      "execution": {
        "mode": "deterministic",
        "shardBy": "none",
        "reason": "Resolve Media Pool bin 组织仍可使用 chronology 作为工程归档依据；不参与素材选择判断。"
      },
      "gate": "none",
      "notes": [
        "chronology 只用于 Resolve bin/path/context 映射，不得改变 material-slots 的选择和顺序。",
        "该 step 不生成剪辑语义文档，也不替代 material.recall。"
      ]
    },
    {
      "id": "timeline-generate-codex-v1",
      "capabilityId": "timeline.generate",
      "title": "生成 Resolve 粗剪时间线",
      "inputRefs": [
        "DaVinci Resolve Media Pool",
        "edits/<editId>/planning/edit-framework.md",
        "edits/<editId>/script/material-slots.json",
        "store/spans.json",
        "store/assets.json",
        "media/chronology.json"
      ],
      "outputRefs": [
        "DaVinci Resolve Timeline",
        ".tmp/edit-flow/<editId>/timeline/current.json"
      ],
      "outputTypes": {
        "DaVinci Resolve Timeline": "resolve-state",
        ".tmp/edit-flow/<editId>/timeline/current.json": "timeline-audit-json"
      },
      "runner": "deterministic",
      "execution": {
        "mode": "deterministic",
        "shardBy": "none",
        "reason": "按 reviewed material-slots 顺序落片；chronology 只提供 Resolve path/bin/context 映射。"
      },
      "gate": "human",
      "notes": [
        "必须以 material-slots.segments 顺序和 chosenSpanIds 顺序为落片真相。",
        "不得因为 chronology 重新排序或替换 chosen spans。",
        "speech-backed 非照片 span 如果被选择，timeline.generate 必须拒绝 audio <= -100 的静音处理。"
      ]
    },
    {
      "id": "resolve-lock-rough-cut-codex-v1",
      "capabilityId": "resolve.lock_rough_cut",
      "title": "人工锁定粗剪",
      "inputRefs": [
        "DaVinci Resolve Timeline",
        "edits/<editId>/script/material-slots.json"
      ],
      "outputRefs": [
        "edits/<editId>/timeline/locked-rough-cut.json"
      ],
      "outputTypes": {
        "edits/<editId>/timeline/locked-rough-cut.json": "rough-cut-lock-json"
      },
      "runner": "manual",
      "execution": {
        "mode": "manual",
        "shardBy": "none",
        "reason": "规则要求人工和 LLM 针对时间线交互修改，直到阶段性定稿后人工确认进入下个阶段。"
      },
      "gate": "human",
      "notes": [
        "该 step 只记录人工确认后的粗剪锁定状态，不自动创建时间线。",
        "锁定前的交互修改发生在 Resolve 时间线和人工审查中。"
      ]
    },
    {
      "id": "postlock-subtitle-narration-codex-v1",
      "capabilityId": "postlock.subtitle_narration",
      "title": "锁定后字幕与旁白草稿",
      "inputRefs": [
        "edits/<editId>/timeline/locked-rough-cut.json",
        "edits/<editId>/script/material-slots.json",
        "store/spans.json",
        "store/assets.json",
        "config/styles/china-drive-travel-documentary-main.md"
      ],
      "outputRefs": [
        "edits/<editId>/subtitles/source-speech.*",
        "edits/<editId>/subtitles/narration-draft.md",
        "edits/<editId>/subtitles/final-subtitles.*"
      ],
      "outputTypes": {
        "edits/<editId>/subtitles/source-speech.*": "subtitle",
        "edits/<editId>/subtitles/narration-draft.md": "planning-markdown",
        "edits/<editId>/subtitles/final-subtitles.*": "subtitle"
      },
      "runner": "agent",
      "execution": {
        "mode": "single-agent",
        "shardBy": "none",
        "codexSubagentProfile": {
          "reasoningEffort": "high",
          "forkContext": false,
          "speed": "standard"
        },
        "reason": "锁定后阶段需要生成源语音字幕，并为无语音段落按已授权文学风格写旁白稿。"
      },
      "gate": "human",
      "notes": [
        "仅此 step 可消费 styleUsage.literary hard 层。",
        "源语音字幕来自被选口播/语音素材；无语音段落的旁白稿必须最终人工审查。",
        "不要把风格档案反向用于改变已锁定的粗剪结构或素材选择。"
      ]
    }
  ]
}
