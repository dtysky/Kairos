{
	Tools = ordered() {
		SubtitleMerge = Merge {
			Inputs = {
				Blend = Input { Expression = "min(max((time-77)/48,0),1)*min(max((394-time)/48,0),1)", },
				Background = Input {
					SourceOp = "TitleMerge",
					Source = "Output",
				},
				Foreground = Input {
					SourceOp = "TitleSubtitle",
					Source = "Output",
				},
				PerformDepthMerge = Input { Value = 0, }
			},
		}
	}
}